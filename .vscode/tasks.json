{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "flash-openocd",
      "type": "shell",
      "command": "openocd",
      "args": [
        "-f", "interface/cmsis-dap.cfg",
        // "-f", "interface/stlink.cfg",
        "-f", "target/stm32h7x.cfg",
        "-c", "adapter speed 1000",
        "-c", "init",
        "-c", "reset halt",
        "-c", "stm32h7x mass_erase 0",
        "-c", "program build/Debug/wbr_chassis.elf",
        "-c", "reset run",
        "-c", "shutdown"
      ]
    }
  ]
}