{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "flash-openocd",
      "type": "shell",
      "command": "openocd",
      "args": [
        "-f", "interface/cmsis-dap.cfg",
        "-f", "target/stm32h7x.cfg",
        "-c", "transport select swd",
        "-c", "reset_config none",
        "-c", "cortex_m reset_config sysresetreq",
        "-c", "init",
        "-c", "halt",
        "-c", "program build/Debug/wbr_chassis.elf",
        "-c", "soft_reset_halt",
        "-c", "sleep 500",
        "-c", "resume",
        "-c", "sleep 500",
        "-c", "exit"
      ],
      "problemMatcher": []
    }
  ]
}